# Kaj Tracker - Environment Variables

# Main Admin Email (Global Admin who can manage all works and system settings)
MAIN_ADMIN_EMAIL=ifti.k.hoq@gmail.com
VITE_MAIN_ADMIN_EMAIL=ifti.k.hoq@gmail.com

# Firebase Client Configuration (Public Web Config for Google Sign-In)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Sheets Configuration (Spreadsheet ID from Google Sheets URL)
SHEET_ID=

# Server Credentials (For Vercel / Serverless API)
# Paste JSON strings or configure in Vercel environment variables
GOOGLE_SERVICE_ACCOUNT_JSON=
FIREBASE_ADMIN_JSON=

# Optional Demo Mode (Set to "true" to run with built-in mock data for testing)
VITE_ENABLE_DEMO_MODE=true

